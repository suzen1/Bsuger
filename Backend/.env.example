# Server Port (Optional, default is 5000)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/bsugar?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=your_jwt_secret_key_here

# GROQ API Key (For Gemini/Llama/Deepseek AI functionalities)
GROQ_API_KEY=your_groq_api_key_here

# Frontend Application URL (Required for production CORS policy)
FRONTEND_URL=https://your-frontend-app.vercel.app
